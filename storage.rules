rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Operators can upload and read their own inventory images
    match /operators/{operatorId}/inventory/{fileId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == operatorId;
    }

    // Public catalogue images (optional)
    match /catalogue/{fileId} {
      allow read: if true;        // public read
      allow write: if request.auth != null;
    }

    // Block everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
