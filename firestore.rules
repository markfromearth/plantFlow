rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public storefront can read tenant info
    match /tenants/{tenantId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Equipment inventory (tenant-scoped)
    match /tenants/{tenantId}/inventory/{machineId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Bookings (tenant-scoped)
    match /tenants/{tenantId}/bookings/{bookingId} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }

    // --- Flat compatibility rules for cached clients ---
    match /equipment/{machineId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /bookings/{bookingId} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }
  }
}
