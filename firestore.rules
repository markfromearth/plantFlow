rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Tenant document
    match /tenants/{tenantId} {
      allow read: if true;
      allow write: if request.auth.uid == request.resource.data.ownerUid;
    }

    // Inventory (machines)
    match /tenants/{tenantId}/inventory/{machineId} {
      allow read: if true;
      allow write: if request.auth.uid ==
        get(/databases/$(database)/documents/tenants/$(tenantId)).data.ownerUid;
    }

    // Bookings
    match /tenants/{tenantId}/bookings/{bookingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
