// MVP rules — safe, correct, matches your frontend

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public storefront can read tenant info
    match /tenants/{tenantId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Equipment inventory
    match /tenants/{tenantId}/inventory/{machineId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Bookings
    match /tenants/{tenantId}/bookings/{bookingId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
